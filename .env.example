# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development

# Local default (no setup needed). For Neon, paste the POOLED connection string; the app converts it for asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Neon: the DIRECT (non-pooled) string, used only by `alembic upgrade head`.
MIGRATION_DATABASE_URL=

# Production requires both. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=dev-only-change-me
FIELD_ENCRYPTION_KEY=

# JSON list. Add the deployed frontend's URL here.
CORS_ORIGINS=["http://localhost:5173"]
