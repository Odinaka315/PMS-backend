# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development

# Local default (no setup needed). For Neon, paste the POOLED connection string; the app converts it for asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Neon: the DIRECT (non-pooled) string, used only by `alembic upgrade head`.
MIGRATION_DATABASE_URL=

# Production requires both. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=dev-only-change-me
FIELD_ENCRYPTION_KEY=

# JSON list. Add the deployed frontend's URL here.
CORS_ORIGINS=["http://localhost:5173"]

# ---- Accounts created by HR -------------------------------------------------------------------------------------
# shared = everyone starts with INITIAL_PASSWORD; random = each account gets its own one-time password shown to HR.
# Everyone must choose their own password at first sign-in, and an unused initial password expires.
INITIAL_PASSWORD_MODE=shared
# Shared mode only. Optional in development (defaults to hospital123); REQUIRED in production, choose your own.
INITIAL_PASSWORD=
INITIAL_PASSWORD_DAYS=14
AUTO_CREATE_ACCOUNTS=true

# ---- Document storage -------------------------------------------------------------------------------------------
# local = files in ./.storage (development, no setup). r2 = Cloudflare R2 (required in production).
STORAGE_BACKEND=local
# For r2: the four values below. R2_BUCKET is the bucket's NAME exactly as shown in the Cloudflare dashboard
# (for example pms-documents-dev). Use a token limited to that one bucket with "Object Read & Write".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
